iber barn after Bennett excavation is done tomorrow. Quality Dairy starts electrical building south of pits tomorrow. Great progress Saturday and today. Rain forecasted for Thursday and possibly Friday. Bennett time card is correct.","subs":[],"survey":[{"a":"N/A","d":""},{"a":"N/A","d":""},{"a":"N/A","d":""},{"a":"N/A","d":""},{"a":"N/A","d":""},{"a":"N/A","d":""}],"sig":"raken/sig/2025-01-27.png","sigTs":1738036020000,"source":"Raken PDF"},{"id":"raken-bluesky-2025-01-28","pid":"raken-bluesky","date":"2025-01-28","by":"Jeff Pool","site":[{"url":"raken/photos/2025-01-28-00.jpg","ts":1738121940000,"cap":""},{"url":"raken/photos/2025-01-28-01.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-02.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-03.jpg","ts":1738122120000,"cap":""}],"att":[{"url":"raken/photos/2025-01-28-04.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-05.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-06.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-07.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-08.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-09.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-10.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-11.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-12.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-13.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-14.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-15.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-16.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-17.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-18.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-19.jpg","ts":1738122120000,"cap":""},{"url":"raken/photos/2025-01-28-20.jpg","ts":1738122120000,"cap":"